# Same OAuth client id as the server's GOOGLE_CLIENT_ID — this one is public
# by design (Google Identity Services runs in the browser), but it is still
# a distinct value from any client *secret*, which must never appear here or
# in any other VITE_* variable: everything in this file ships to the browser.
# Optional: leave unset and the "Continue with Google" button is not shown.
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id.apps.googleusercontent.com

# The API's own origin. Leave unset for local dev (Vite's proxy already makes
# /api same-origin) and for any deployment where the client and API are
# served from the same origin. Set only when they are hosted separately —
# e.g. a static site + a web service on two different subdomains — so REST
# calls and the socket connection reach the API instead of the client's own
# origin. No trailing slash.
VITE_API_URL=https://your-api-service.onrender.com
