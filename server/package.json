{
  "name": "sitare-erp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitare University ERP - API server (Attendance Module)",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "prisma migrate deploy && node src/server.js",
    "build": "prisma generate",
    "seed": "node src/seed/seed.js",
    "seed:demo": "node src/seed/fixture.js",
    "security-check": "node security-check.mjs",
    "google-auth-check": "node google-auth-check.mjs",
    "guard:ids": "node guard-ids.mjs",
    "api-snapshot": "node api-snapshot.mjs",
    "create-admin": "node create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
