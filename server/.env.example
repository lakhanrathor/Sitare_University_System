NODE_ENV=development
PORT=5000
# PostgreSQL 15 or newer — earlier versions have no NULLS NOT DISTINCT, which
# the schema depends on. `docker compose up -d db` at the repo root starts one
# matching this URL; any PostgreSQL 15+ reachable here works just as well.
DATABASE_URL=postgresql://sitare:sitare_dev@127.0.0.1:5433/sitare_erp
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# OAuth client id from Google Cloud Console (APIs & Services > Credentials).
# Optional: leave unset to keep email/password login as the only method —
# the /auth/google route simply reports itself as not configured.
# No client secret is needed here: the server only verifies a Google-signed
# ID token, it never exchanges an authorization code.
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id.apps.googleusercontent.com
